# Variables d'environnement — copier vers .env.local et compléter.
# Ne jamais committer de secrets réels.

# Emails admin (/admin, /api/admin) — séparés par des virgules
ADMIN_EMAILS=admin@example.com,admin2@example.com

# Comptes internes BLOCKTRUST (plans Enterprise, bootstrap) — séparés par des virgules
INTERNAL_EMAILS=internal@example.com,team@example.com

# Super-admin dashboard (optionnel — fallback hardcodé en dev)
# SUPER_ADMIN_EMAIL=admin@example.com

# OAuth Google — linking automatique compte email (désactivé par défaut)
# ALLOW_DANGEROUS_EMAIL_LINKING=true

# Extension Chrome TrustScan — ID Web Store (obligatoire en production)
EXTENSION_ID=bemcnlbifffejlijnndkdgcjpmijfaeg
