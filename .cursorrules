## ⚠️ ANTI-PATTERNS — NE JAMAIS FAIRE

```typescript
// ❌ PrismaClient ad hoc
const prisma = new PrismaClient()

// ❌ userId depuis body/query
const userId = req.body.userId

// ❌ wallet.address comme destinataire
to: wallet.address

// ❌ POLYGON_PRIVATE_KEY dans les logs
console.log(process.env.POLYGON_PRIVATE_KEY)

// ❌ apiKeyHash dans les réponses
return { apiKeyHash: config.apiKeyHash }

// ❌ "KYC" visible utilisateur
<p>Complétez votre KYC</p>

// ❌ "entité" visible utilisateur
<p>Mes entités</p>

// ❌ Stats non vérifiables sur landing
<p>99,9% de disponibilité</p>

// ❌ Silver/Bronze/Gold comme niveaux
badge.level === 'BRONZE'

// ❌ Turbopack activé
experimental: { turbopack: true }

// ❌ startsWith pour comparaison de hash
hash.startsWith(providedHash) // timing attack

// ❌ IP en clair dans la DB
ipAddress: request.ip // RGPD violation
```

