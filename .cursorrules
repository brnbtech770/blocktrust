## ✅ PATTERNS RECOMMANDÉS

```typescript
// ✅ Session auth
const session = await auth()
if (!session?.user?.id) redirect('/auth/signin')

// ✅ Ownership check Prisma
const cert = await prisma.certificate.findUnique({
  where: { id, entity: { userId: session.user.id } }
})

// ✅ Fire-and-forget (ne jamais bloquer la réponse)
someAsyncOperation().catch(err => 
  console.error('[operation]', err)
)

// ✅ IP hashing RGPD
import { createHash } from 'crypto'
const ipHash = createHash('sha256')
  .update(ip + process.env.NEXTAUTH_SECRET)
  .digest('hex')

// ✅ Token generation sécurisé
import { randomBytes } from 'crypto'
const token = randomBytes(32).toString('base64url')

// ✅ Fail-soft rate limiting
try {
  const { success } = await ratelimit.limit(id)
  if (!success) return new Response(null, { status: 429 })
} catch { /* fail open */ }

// ✅ Server Component par défaut
// "use client" uniquement si useState/useEffect nécessaire

// ✅ Sentry en production uniquement
enabled: process.env.NODE_ENV === 'production'
```

