{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "github": {
    "silent": true
  },
  "ignoreCommand": "echo \"${VERCEL_GIT_COMMIT_REF:-}\" | grep -qE dependabot && exit 0; git log -1 --format=%s | grep -qE dependabot",
  "crons": [
    {
      "path": "/api/cron/anomaly-detection",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/trustscore-update",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/threat-articles",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/account-deletion",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/subscription-monitor",
      "schedule": "0 9 * * *"
    }
  ]
}
