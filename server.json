{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.brnbtech770/blocktrust-trustscan",
  "title": "BLOCKTRUST TrustScan",
  "description": "Trust verification for AI agents: identities, domains, phishing, contacts, Trust Circle, Vault.",
  "version": "1.0.0",
  "websiteUrl": "https://blocktrust.tech/mcp",
  "repository": {
    "url": "https://github.com/brnbtech770/blocktrust",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://blocktrust.tech/mcp/sse",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer bt_ext_… API key from https://blocktrust.tech/dashboard/extension",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
