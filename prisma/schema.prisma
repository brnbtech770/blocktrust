// BlockTrust - Schema Prisma Complet
// Version: 2.0 - Février 2026
// Inclut: Core, Trust Circle, Plans, Stripe, Multi-Tenant
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AUTHENTIFICATION & UTILISATEURS
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  // Legacy : ancien token en clair. Désormais optionnel et plus jamais écrit.
  token     String?  @unique
  // Hash SHA-256 du token (hash at rest). Le token en clair n'est transmis que par email.
  tokenHash String?  @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([tokenHash])
  @@index([email])
}

// Idempotence des webhooks Stripe (cas financier critique). La contrainte unique
// sur `eventId` garantit qu'un événement n'est traité qu'une seule fois, même si
// le cache Redis est indisponible (fail-closed via la base).
model ProcessedStripeEvent {
  eventId   String   @id
  type      String?
  createdAt DateTime @default(now())
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  company       String?
  phone         String?
  password      String?
  accountType   AccountType @default(PERSONAL)

  // Relation plan & paiement
  planId           String?
  plan             Plan?         @relation(fields: [planId], references: [id])
  stripeCustomerId String?       @unique
  subscription     Subscription?

  // KYC Stripe Identity
  kycStatus         String    @default("PENDING")
  kycVerifiedAt     DateTime?
  kycRejectedAt     DateTime?
  kycRejectedReason String?
  stripeIdentityId  String?   @unique
  siret             String?
  companyName       String?

  cguAcceptedAt   DateTime?
  cguVersion      String?   @default("1.0")
  cgvAcceptedAt        DateTime?
  cgvVersion           String?
  retractationWaiverAt DateTime?
  cookieConsent   Boolean   @default(false)
  cookieConsentAt DateTime?

  /// Consentement explicite RGPD Art. 9 — données biométriques (Stripe Identity)
  biometricConsentAt      DateTime?
  biometricConsentVersion String?

  verifyCount      Int      @default(0)
  verifyCountReset DateTime @default(now())

  trustScore   Int       @default(0)
  trustScoreAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  entities Entity[]
  devices  UserDevice[]

  // Organisation (B2B)
  ownedOrganizations      Organization[]       @relation("OrganizationOwner")
  organizationMemberships OrganizationMember[]

  // Compte personnel (B2C)
  ownedPersonalAccounts      PersonalAccount[]       @relation("PersonalAccountOwner")
  personalAccountMemberships PersonalAccountMember[]

  // KYC & Trust Circle (User-centric)
  kycVerifications       KYCVerification[]
  userTrustFrom          UserTrustRelation[]    @relation("UserTrustFrom")
  userTrustTo            UserTrustRelation[]    @relation("UserTrustTo")
  userManualTrustEntries UserManualTrustEntry[]
  adminAlerts            AdminAlert[]

  // White Label / API
  whiteLabelConfig WhiteLabelConfig?

  // BlockTrust Vault (B2B) — entrées rédigées par l’utilisateur
  vaultEntriesAuthored TrustVaultEntry[] @relation("VaultEntryAuthor")
  vaultPermissions     TrustVaultPermission[]

  /// Clé API extension Chrome (TrustScan) — jamais la valeur secrète complète : hash SHA-256 uniquement.
  extensionApiKeyHash String? @unique
  /// Indice affichage tableau de bord (ex. suffixe non secret), optionnel.
  extensionApiKey     String? @unique

  /// Coordonnées certifiées au niveau compte (fusionnées avec celles de l’entité sur /verify public).
  certifiedEmails  String[] @default([])
  certifiedPhones  String[] @default([])
  certifiedDomains String[] @default([])

  @@index([trustScore])
}

enum AccountType {
  PERSONAL
  BUSINESS
}

model UserDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName String
  deviceType String
  userAgent  String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ============================================================
// ORGANISATIONS (B2B)
// ============================================================

model Organization {
  id         String  @id @default(cuid())
  name       String
  /// Identifiant URL unique (équipe / vault)
  slug       String  @unique @default(cuid())
  /// Code plan B2B pour quotas Vault (STARTER, TEAM, BUSINESS, …)
  tier       String  @default("STARTER")
  siret      String? @unique
  vatNumber  String?
  address    String?
  city       String?
  postalCode String?
  country    String  @default("FR")

  ownerId String
  owner   User   @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  planId           String?
  plan             Plan?   @relation(fields: [planId], references: [id])
  stripeCustomerId String? @unique

  maxSeats Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  OrganizationMember[]
  entities Entity[]
  vaults   TrustVault[]

  @@index([ownerId])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(MEMBER)
  invitedAt      DateTime     @default(now())
  joinedAt       DateTime?

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

enum OrgRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

model TrustVault {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      TrustVaultEntry[]
  permissions  TrustVaultPermission[]

  @@index([organizationId])
}

model TrustVaultEntry {
  id          String         @id @default(cuid())
  vaultId     String
  name        String
  type        VaultEntryType
  value       String
  description String?
  addedById   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  vault   TrustVault @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  addedBy User       @relation("VaultEntryAuthor", fields: [addedById], references: [id], onDelete: Restrict)

  @@index([vaultId])
  @@index([type])
}

model TrustVaultPermission {
  id      String    @id @default(cuid())
  vaultId String
  userId  String?
  role    VaultRole @default(MEMBER)

  vault TrustVault @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vaultId])
  @@index([userId])
}

enum VaultRole {
  ADMIN
  MANAGER
  MEMBER
}

enum VaultEntryType {
  CONTACT
  DOMAIN
  EMAIL
  PHONE
  URL
  WALLET
}

// ============================================================
// COMPTES PERSONNELS (B2C Famille)
// ============================================================

model PersonalAccount {
  id   String @id @default(cuid())
  name String @default("Mon compte")

  ownerId String
  owner   User   @relation("PersonalAccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  planId           String?
  plan             Plan?   @relation(fields: [planId], references: [id])
  stripeCustomerId String? @unique

  maxProfiles Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members PersonalAccountMember[]

  @@index([ownerId])
}

model PersonalAccountMember {
  id                String          @id @default(cuid())
  personalAccountId String
  personalAccount   PersonalAccount @relation(fields: [personalAccountId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              String          @default("MEMBER")
  invitedAt         DateTime        @default(now())
  joinedAt          DateTime?

  @@unique([personalAccountId, userId])
}

// ============================================================
// PLANS & ABONNEMENTS
// ============================================================

model Plan {
  id       String          @id @default(cuid())
  name     String
  type     PlanType
  price    Decimal         @db.Decimal(10, 2)
  currency String          @default("EUR")
  interval BillingInterval @default(MONTHLY)

  // Limites B2C
  maxProfiles Int @default(1)
  maxEntities Int @default(20)

  // Limites B2B
  maxSeats            Int @default(3)
  maxCertificates     Int @default(10)
  apiRequestsPerMonth Int @default(1000)

  // Features
  trustCircleEnabled Boolean @default(false)
  blockchainAnchor   Boolean @default(false)
  whitelabelEnabled  Boolean @default(false)
  aiAlertsEnabled    Boolean @default(false)
  prioritySupport    Boolean @default(false)

  stripePriceId String? @unique

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users            User[]
  organizations    Organization[]
  personalAccounts PersonalAccount[]
}

enum PlanType {
  TRIAL
  B2C_ESSENTIEL
  B2C_PREMIUM
  B2C_FAMILLE
  B2C_FAMILLE_PLUS
  B2B_SOLO_PRO
  B2B_STARTER
  B2B_TEAM
  B2B_BUSINESS
  B2B_ENTERPRISE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  plan                 String    @default("DISCOVERY") // DISCOVERY (gratuit) puis ESSENTIEL, PREMIUM, FAMILLE…
  status               String    @default("inactive") // active, inactive, past_due, canceled
  /// Sièges achetés (B2B Team facturé par utilisateur). Null = quota dérivé du plan.
  seats                Int?
  /// Profils Famille supplémentaires achetés (add-on, en plus des 5 inclus).
  extraProfiles        Int?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@index([plan])
}

// ============================================================
// ENTITÉS & CERTIFICATS
// ============================================================

model Entity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Organisation optionnelle (B2B)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  entityType EntityType @default(BUSINESS)

  // Champs B2B
  legalName String?
  tradeName String?
  siret     String? @unique
  vatNumber String?

  // Champs B2C
  firstName String?
  lastName  String?

  // Champs communs
  email       String
  phone       String?
  website     String?
  address     String?
  city        String?
  postalCode  String?
  country     String  @default("FR")
  description String? @db.Text
  logoUrl     String?

  /// Adresse wallet optionnelle (ETH / MATIC / BTC / etc.)
  walletAddress String?
  /// ex. ethereum | polygon | bitcoin | solana | autre
  walletNetwork String?

  /// Domaines officiels certifiés (anti-miroir / typosquatting)
  certifiedDomains String[] @default([])
  certifiedEmails  String[] @default([])
  certifiedPhones  String[] @default([])

  // Vérification
  kycStatus       KycStatus       @default(PENDING)
  validationLevel ValidationLevel @default(DISCOVERY)
  emailVerified   Boolean         @default(false)
  phoneVerified   Boolean         @default(false)
  domainVerified  Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  certificates Certificate[]
  signatures   Signature[]
  trustScore   TrustScore?
  aiAlerts     AIAlert[]
  adminAlerts  AdminAlert[]

  // Trust Circle
  trustRequestsSent     TrustRelation[]    @relation("TrustRequester")
  trustRequestsReceived TrustRelation[]    @relation("TrustRequestee")
  manualTrustEntries    ManualTrustEntry[]

  // Badge Interactions
  interactionsAsA BadgeInteraction[] @relation("InteractionBadgeA")
  interactionsAsB BadgeInteraction[] @relation("InteractionBadgeB")

  @@index([userId])
  @@index([organizationId])
  @@index([email])
  @@index([siret])
}

enum EntityType {
  BUSINESS
  INDIVIDUAL
  ASSOCIATION
  PUBLIC_ENTITY
}

enum KycStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  REJECTED
  EXPIRED
}

enum ValidationLevel {
  DISCOVERY
  ESSENTIEL
  PREMIUM
  FAMILLE
  STARTER
  TEAM
  ENTERPRISE
}

model Certificate {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  // Identifiants
  publicId String? @unique @default(cuid())

  // Blockchain (legacy fields)
  txHash          String?   @unique
  blockNumber     Int?
  contractAddress String?
  tokenId         String?
  merkleRoot      String?
  anchoredAt      DateTime?

  // Ancrage Polygon réel (avril 2026)
  polygonTxHash      String?   @unique
  polygonBlock       Int?
  polygonAnchoredAt  DateTime?
  polygonExplorerUrl String?
  blockchainStatus   String    @default("PENDING") // PENDING | ANCHORED | FAILED

  // Métadonnées
  level  ValidationLevel   @default(DISCOVERY)
  status CertificateStatus @default(PENDING)

  issuedAt         DateTime  @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  revocationReason String?

  // Stats
  verificationCount Int       @default(0)
  lastVerifiedAt    DateTime?

  signatures    Signature[]
  verifications Verification[]

  // Badge Interactions
  interactionsAsA BadgeInteraction[] @relation("CertificateA")
  interactionsAsB BadgeInteraction[] @relation("CertificateB")
  aiAlerts        AIAlert[]

  @@index([entityId])
  @@index([status])
  @@index([publicId])
  @@index([blockchainStatus])
}

enum CertificateStatus {
  PENDING
  ACTIVE
  ANCHORED
  SUSPENDED
  REVOKED
  EXPIRED
}

// ============================================================
// SIGNATURES V2 (Anti-Falsification)
// ============================================================

model Signature {
  id  String @id @default(uuid())
  jti String @unique

  certificateId String
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  // Payload complet
  payload Json?

  // Contexte anti-copie
  contextHash String?
  targetUrl   String?
  purpose     String?

  // Signature cryptographique
  signature String? @db.Text

  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  revoked   Boolean   @default(false)

  // QR dynamique (usage limité)
  maxScans      Int       @default(10)
  scanCount     Int       @default(0)
  lastScannedAt DateTime?
  dynamicToken  String?   @unique
  tokenExpiry   DateTime?

  @@index([certificateId])
  @@index([entityId])
  @@index([jti])
  @@index([dynamicToken])
}

// ============================================================
// VÉRIFICATIONS
// ============================================================

model Verification {
  id            String       @id @default(cuid())
  /// Null pour événements hors certificat (ex. rate limit avant résolution)
  certificateId String?
  certificate   Certificate? @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  ipHash    String?
  userAgent String?
  referer   String?
  country   String?

  result       VerificationResult @default(VALID)
  signatureJti String?
  metadata     Json?

  verifiedAt DateTime @default(now())

  @@index([certificateId])
  @@index([verifiedAt])
  @@index([result])
  @@index([ipHash, verifiedAt])
}

enum VerificationResult {
  VALID
  FRAUD_ALERT
  EXPIRED
  REVOKED
  NOT_FOUND
  RATE_LIMITED
  QR_EXPIRED
  SUSPICIOUS_VOLUME
  SUSPICIOUS_SCANNING
}

// ============================================================
// VEILLE CYBER — RSS (cron) + synthèses Claude
// ============================================================

model ThreatArticle {
  id             String    @id @default(cuid())
  /// CERT_FR | CYBERMALVEILLANCE | ZATAZ
  source         String
  sourceUrl      String    @unique
  title          String    @db.Text
  excerpt        String?   @db.Text
  summaryFr      String    @default("") @db.Text
  relevanceScore Int       @default(0)
  publishedAt    DateTime?
  fetchedAt      DateTime  @default(now())
  processedAt    DateTime?

  @@index([relevanceScore(sort: Desc), publishedAt(sort: Desc)])
  @@index([processedAt])
}

// ============================================================
// TRUST CIRCLE
// ============================================================

model TrustRelation {
  id String @id @default(cuid())

  requesterId String
  requester   Entity @relation("TrustRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  requesteeId String
  requestee   Entity @relation("TrustRequestee", fields: [requesteeId], references: [id], onDelete: Cascade)

  status TrustStatus @default(PENDING)

  txHash String?

  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  revokedAt   DateTime?
  revokedBy   String?

  message          String?
  relationshipType String?

  @@unique([requesterId, requesteeId])
  @@index([requesterId])
  @@index([requesteeId])
  @@index([status])
}

enum TrustStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

model ManualTrustEntry {
  id String @id @default(cuid())

  ownerId String
  owner   Entity @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  trustedName   String
  trustedEmail  String?
  trustedPhone  String?
  trustedDomain String?
  trustedSiret  String?

  emailVerified  Boolean @default(false)
  domainVerified Boolean @default(false)

  category String?
  notes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([trustedDomain])
}

// ============================================================
// KYC STRIPE IDENTITY (User)
// ============================================================

model KYCVerification {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSessionId       String    @unique
  stripeVerificationUrl String?
  status                String    @default("PENDING")
  accountType           String    @default("INDIVIDUAL")
  documents             Json?
  siretVerified         Boolean   @default(false)
  siretData             Json?
  adminOverride         Boolean   @default(false)
  adminOverrideBy       String?
  adminOverrideAt       DateTime?
  adminOverrideReason   String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

// ============================================================
// TRUST CIRCLE USER-CENTRIC (User↔User, invitations)
// ============================================================

model UserTrustRelation {
  id           String    @id @default(cuid())
  fromUserId   String
  fromUser     User      @relation("UserTrustFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId     String?
  toUser       User?     @relation("UserTrustTo", fields: [toUserId], references: [id], onDelete: SetNull)
  toEmail      String?
  toName       String?
  toEntityType String    @default("INDIVIDUAL")
  trustType    String    @default("UNVERIFIED")
  status       String    @default("PENDING")
  isMutual     Boolean   @default(false)
  inviteToken  String?   @unique
  inviteExpiry DateTime?
  inviteSentAt DateTime?
  confirmedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([inviteToken])
  @@index([toEmail])
  @@index([status])
}

// ============================================================
// DEMANDES MANUELLES TRUST (User → Admin)
// ============================================================

model UserManualTrustEntry {
  id                String    @id @default(cuid())
  requestedBy       String
  user              User      @relation(fields: [requestedBy], references: [id], onDelete: Cascade)
  entityName        String
  entityEmail       String?
  entityType        String    @default("INDIVIDUAL")
  siret             String?
  documents         Json?
  status            String    @default("PENDING_ADMIN")
  adminValidatedBy  String?
  adminValidatedAt  DateTime?
  adminRejectedAt   DateTime?
  adminRejectReason String?
  kycLevel          String    @default("MANUAL_VERIFIED")
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([requestedBy])
  @@index([status])
}

// ============================================================
// TRUST SCORE
// ============================================================

model TrustScore {
  id String @id @default(cuid())

  entityId String @unique
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  score Int @default(50)

  kycScore         Int @default(0)
  historyScore     Int @default(0)
  interactionScore Int @default(0)
  behaviorScore    Int @default(0)
  networkScore     Int @default(0)

  penalties Int @default(0)

  level TrustLevel @default(STANDARD)

  previousScore  Int?
  lastCalculated DateTime @default(now())

  @@index([score])
  @@index([level])
}

enum TrustLevel {
  UNVERIFIED
  STANDARD
  TRUSTED
  HIGHLY_TRUSTED
  ELITE
}

// ============================================================
// BADGE INTERACTIONS
// ============================================================

model BadgeInteraction {
  id String @id @default(cuid())

  entityAId String?
  entityA   Entity? @relation("InteractionBadgeA", fields: [entityAId], references: [id], onDelete: Cascade)

  entityBId String?
  entityB   Entity? @relation("InteractionBadgeB", fields: [entityBId], references: [id], onDelete: Cascade)

  certificateAId String?
  certificateA   Certificate? @relation("CertificateA", fields: [certificateAId], references: [id], onDelete: Cascade)

  certificateBId String?
  certificateB   Certificate? @relation("CertificateB", fields: [certificateBId], references: [id], onDelete: Cascade)

  interactionType InteractionType

  txHash      String?
  metadata    Json?
  initiatedBy String

  createdAt DateTime @default(now())

  @@index([entityAId])
  @@index([entityBId])
  @@index([certificateAId])
  @@index([certificateBId])
  @@index([interactionType])
}

enum InteractionType {
  ENDORSEMENT
  COLLABORATION
  VERIFICATION
  TRANSACTION
  REPORT
}

// ============================================================
// IA & ALERTES
// ============================================================

model AIAlert {
  id String @id @default(cuid())

  entityId      String?
  entity        Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)
  certificateId String?
  certificate   Certificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull)

  alertType AlertType
  severity  AlertSeverity @default(MEDIUM)

  title       String
  description String @db.Text
  details     Json?

  status     AlertStatus @default(PENDING)
  resolvedAt DateTime?
  resolvedBy String?
  resolution String?

  createdAt DateTime @default(now())

  @@index([entityId])
  @@index([certificateId])
  @@index([alertType])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

enum AlertType {
  SUSPICIOUS_ACTIVITY
  IDENTITY_MISMATCH
  UNUSUAL_PATTERN
  PHISHING_ATTEMPT
  CERTIFICATE_ABUSE
  TRUST_CIRCLE_ANOMALY
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
  ESCALATED
}

/// Alertes opérationnelles admin (inscriptions, KYC, paiements, fraude, certificats…)
model AdminAlert {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String   @db.Text
  entityId    String?
  entity      Entity?  @relation(fields: [entityId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata    Json?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([read, createdAt])
  @@index([type])
}

// ============================================================
// WHITE LABEL — MARQUE BLANCHE & API PUBLIQUE
// ============================================================

model WhiteLabelConfig {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Branding
  companyName    String
  primaryColor   String  @default("#00d4ff")
  secondaryColor String  @default("#BDA76B")
  logoUrl        String?

  // API — la clé en clair n'est JAMAIS stockée. `apiKey` ne contient que l'affichage
  // masqué (ex: bt_live_••••••••••••••••••••abcd). La vérification passe par apiKeyHash.
  apiKey        String?
  apiKeyHash    String  @unique
  webhookUrl    String?
  webhookSecret String?

  // Permissions
  canEmbed  Boolean @default(true)
  canVerify Boolean @default(true)
  canIssue  Boolean @default(false)

  // Stats
  apiCallsCount Int @default(0)
  apiCallsLimit Int @default(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([apiKey])
  @@index([apiKeyHash])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id String @id @default(cuid())

  userId   String?
  entityId String?

  action     String
  resource   String
  resourceId String?

  oldValue Json?
  newValue Json?

  ipHash    String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}
